# TRACE data and embedding locations. Relative defaults are data/datasets and
# data/embeddings below the repository root.
TRACE_DATASET_ROOT=/path/to/datasets
TRACE_EMBEDDING_ROOT=/path/to/embeddings
WANDB_MODE=offline

# Optional for the UI and paper media export.
BARISTA_VIDEO_ROOT=/path/to/datasets/Barista/videos
BREAKFAST_VIDEO_ROOT=/path/to/datasets/Breakfast/videos
MPII_VIDEO_ROOT=/path/to/datasets/MPII_Cooking_2/videos
