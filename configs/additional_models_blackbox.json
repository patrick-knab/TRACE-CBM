      "base_method": "feature_slowfast_tcn"
    },
    {
      "name": "gtea_s1_feature_transformer_seed{seed}",
      "dataset": "gtea_gaze",
      "test_split": "s1",
      "concept_set": "gtea_gaze_iterative_qwen35_pe_l14_128_v1",
      "embedding_path": "data/embeddings/GTEA_Gaze/True_32_clip_pe-l14_state.pkl",
      "activity_label_mode": "verb",
      "base_method": "feature_transformer"
    },
    {
      "name": "epic_kitchens_s1_slowfast_tcn_seed{seed}",
      "dataset": "epic_kitchens_100",
      "test_split": "s1",
      "concept_set": "epic_kitchens_100_iterative_qwen35_pe_l14_128_v1",
      "embedding_path": "data/embeddings/EPIC-KITCHENS-100/True_32_clip_pe-l14_state.pkl",
      "base_method": "feature_slowfast_tcn"
    },
    {
      "name": "epic_kitchens_s1_feature_transformer_seed{seed}",
      "dataset": "epic_kitchens_100",
      "test_split": "s1",
      "concept_set": "epic_kitchens_100_iterative_qwen35_pe_l14_128_v1",
